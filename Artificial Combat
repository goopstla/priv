local function GetFoldersFromPaths(pathList)
    if not pathList or type(pathList) ~= "table" then return {} end
    
    local resolvedFolders = {}
    for _, pathString in ipairs(pathList) do
        if pathString == "Workspace" then
            table.insert(resolvedFolders, game.Workspace)
        else
            local current = game.Workspace
            local parts = string.split(pathString, "/")
            local found = true
            
            for _, part in ipairs(parts) do
                current = current:FindFirstChild(part)
                if not current then 
                    found = false
                    break 
                end
            end
            
            if found and current then
                table.insert(resolvedFolders, current)
            end
        end
    end
    
    return resolvedFolders
end

local function GetAllFoldersInWorkspace()
    local Folders = {"Workspace"} -- Add Workspace as a selectable option

    local function Scan(parent, prefix)
        for _, child in ipairs(parent:GetChildren()) do
            if child.ClassName == "Folder" then
                local fullPath = prefix == "" and child.Name or (prefix .. "/" .. child.Name)
                table.insert(Folders, fullPath)
                -- Recursively scan up to 2 levels deep
                if #string.split(fullPath, "/") < 3 then
                    Scan(child, fullPath)
                end
            end
        end
    end

    Scan(game.Workspace, "")
    return Folders
end

local function GetAllCharactersInFolder()
    if not SelectedFolder or (type(SelectedFolder) == "table" and #SelectedFolder == 0) then 
        UI_Library:Notify("ERROR", "Select a folder first") 
        return {} 
    end 

    -- Ensure SelectedFolder is treated as a table
    local pathsToProcess = type(SelectedFolder) == "table" and SelectedFolder or {SelectedFolder}
    local TargetFolders = GetFoldersFromPaths(pathsToProcess)
    
    if #TargetFolders == 0 then 
        UI_Library:Notify("ERROR", "Selected folder paths not found") 
        return {} 
    end 

    local Characters = {}
    for _, TargetFolder in ipairs(TargetFolders) do
        for _, Character in ipairs(TargetFolder:GetChildren()) do  
            if Character.ClassName == "Model" and Character:FindFirstChildWhichIsA("Humanoid") then
                if not IncludeLocalCharacter then 
                    if Character == game.Players.LocalPlayer.Character then continue end 
                end
                table.insert(Characters, Character)
            end
        end
    end

    return Characters
end

local function SetClipboardLoggedCache()
    local totalItems = #AnimationsLoggedOrder
    if totalItems == 0 then
        print("[Clipboard] Nothing logged to copy.")
        return
    end

    local ids = {}
    for i = 1, totalItems do
        -- Extract only the numbers from the asset ID string
        local numericId = tostring(AnimationsLoggedOrder[i]):match("%d+")
        if numericId then
            table.insert(ids, numericId)
        end
    end

    local clipboardString = table.concat(ids, ",")
    
    setclipboard(clipboardString)
    print(string.format("[Clipboard] Successfully copied %d logged animation IDs!", #ids))
    UI_Library:Notify("Clipboard", string.format("Successfully copied %d logged animation IDs!", #ids))
end

local function SetClipboardIgnoreList()
    local totalItems = #AnimationsLoggedOrder
    if totalItems == 0 then
        print("[Clipboard] Nothing logged to copy.")
        return
    end
    
    local newlyAddedIds = {}

    for AnimationId, AnimData in pairs(AnimationsLoggedCache) do  
        local numericId = tonumber(string.match(tostring(AnimationId), "%d+"))
        
        if numericId then
            table.insert(IgnoreIds, numericId)
            
            table.insert(newlyAddedIds, tostring(numericId))
        end
    end

    local outputstring = table.concat(newlyAddedIds, ", ")
    setclipboard(outputstring)    

    print(string.format("[Clipboard] Copied %d NEW IDs! (Total historical ignored count is now: %d)", #newlyAddedIds, #IgnoreIds))
end

