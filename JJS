                    charactersToScan = res
                end
            end
            
            for _, targetChar in ipairs(charactersToScan) do
                if targetChar ~= char then
                    local activeAnimations = AnimationTracker:Update(targetChar) or {}
                    
                    for _, anim in ipairs(activeAnimations) do
                        if not anim.AnimationId then continue end 
