local function CalculateParryTiming(attackConfig, StartTime)
    local optimalReactionTime = attackConfig.ParryTime or (attackConfig.ReactionTime or DefaultReactionTime)
    local adjustedReactionTime = optimalReactionTime + ParryOffset
    
    local windows = {}
    
    if attackConfig.HitTimes and type(attackConfig.HitTimes) == "table" then
        for _, hitOffset in ipairs(attackConfig.HitTimes) do
            local hitStart = StartTime + hitOffset + ParryOffset
            table.insert(windows, {
                Start = hitStart,
                Expire = hitStart + ParryWindow,
                Parried = false
            })
        end
    else
        local parryWindowStart = adjustedReactionTime
        local parryWindowEnd = adjustedReactionTime + ParryWindow
        
        -- If SpamAfterHits is enabled on a single-hit/ParryTime move, 
        -- we can split it or treat it as a multi-window structure
        if attackConfig.SpamAfterHits then
            table.insert(windows, {
                Start = StartTime + parryWindowStart,
                Expire = StartTime + parryWindowEnd + (attackConfig.HoldDuration or 0.3),
                Parried = false
            })
        else
            table.insert(windows, {
                Start = StartTime + parryWindowStart,
                Expire = StartTime + parryWindowEnd,
                Parried = false
            })
        end
    end
    
    return windows
end

local function UpdateAnimationRegistry(animKey, anim, now, currentTrackTime, attackConfig)
    if not AnimationRegistry[animKey] then
        local adjustedNow = now - currentTrackTime
        local windows = CalculateParryTiming(attackConfig, adjustedNow)

        AnimationRegistry[animKey] = {
            StartTime = adjustedNow,
            Processed = false,
            CurrentClockTime = os.clock(),
            CurrentTrackTime = currentTrackTime,
            ReactionTime = attackConfig,
            AnimationId = anim.AnimationId,
            Windows = windows,
            RandomNum = math.random(1, 100),
        }
    end
    
    local regData = AnimationRegistry[animKey]
    regData.CurrentClockTime = os.clock()
    regData.CurrentTrackTime = currentTrackTime

    return regData
end

local function CheckAnimationDirection(character, localCharacter, localRoot, targetRoot, attackConfig, distance)
    if character.Address == localCharacter.Address then return true end
    
    -- If both toggles are turned on, bypass/ignore direction checks completely
    if TargetFacingYou.Get() and YouFacingTarget.Get() then
        return true
    end
    
    local direction = (targetRoot.Position - localRoot.Position).Unit
    local isHeavy = attackConfig.DisplayName == "M2" or attackConfig.DisplayName == "Heavy" or attackConfig.Heavy
    
    if not isHeavy then  
        if TargetFacingYou.Get() and targetRoot.CFrame.LookVector:Dot(-direction) < 0.25 then return false end
        if YouFacingTarget.Get() and localRoot.CFrame.LookVector:Dot(direction) < 0.25 then return false end
    end
    
    return true
end

